# Deployed Sepolia contract addresses (auto-written by
# `npm run deploy:sepolia:sync` from blockchain/ — see blockchain/deployed.json)
NEXT_PUBLIC_ARTISAN_REGISTRY_ADDRESS=0xYourArtisanRegistryAddress
NEXT_PUBLIC_PRODUCT_REGISTRY_ADDRESS=0xYourProductRegistryAddress
NEXT_PUBLIC_PRODUCT_NFT_ADDRESS=0xYourProductNFTAddress
NEXT_PUBLIC_DYNAMIC_ROYALTY_ADDRESS=0xYourDynamicRoyaltyAddress
NEXT_PUBLIC_ESCROW_MARKETPLACE_ADDRESS=0xYourEscrowMarketplaceAddress

# Target chain
NEXT_PUBLIC_CHAIN_ID=11155111

# Public RPC endpoint for Sepolia reads/writes
NEXT_PUBLIC_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Websocket RPC endpoint for realtime monitor events
NEXT_PUBLIC_WS_RPC_URL=wss://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Optional model inference API endpoint for craft scoring
NEXT_PUBLIC_CRAFT_MODEL_INFERENCE_URL=https://your-api.example.com/infer/craft-detector

# Public deployment URL shown in footer / used to build shareable links
NEXT_PUBLIC_VERCEL_URL=https://your-app.vercel.app
# Alternative/preferred base URL for shareable transfer links (takes priority over
# NEXT_PUBLIC_VERCEL_URL if set)
NEXT_PUBLIC_APP_URL=

# --- IPFS (Pinata) ---
# NEXT_PUBLIC_PINATA_JWT is used client-side; PINATA_JWT is used by the server-side
# upload route (app/api/ipfs/upload/route.js). Set both to the same token.
NEXT_PUBLIC_PINATA_JWT=your-pinata-jwt
PINATA_JWT=your-pinata-jwt
NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# --- AI craft/terroir verification (app/api/verify-craft/route.js) ---
# Selects which provider the route calls. No offline fallback exists — the route
# returns an error if the selected provider's key is missing.
VISION_PROVIDER=openai
OPENAI_API_KEY=your-openai-key
OPENAI_VISION_MODEL=gpt-4.1
GEMINI_API_KEY=your-gemini-key
GEMINI_VISION_MODEL=gemini-1.5-pro

# --- Anon Aadhaar identity verification ---
# NEXT_PUBLIC_ANON_AADHAAR_USE_TEST_MODE drives the client widget (app/providers.js).
# ANON_AADHAAR_USE_TEST_MODE (no NEXT_PUBLIC_ prefix) drives the backend verifier
# (app/api/verify-aadhaar/route.js). THESE TWO MUST BE SET TO THE SAME VALUE (or both
# left unset) — a mismatch means the frontend proof widget and backend verifier would
# check against different pubkey hashes (test vs production UIDAI key), which fails
# loudly at server startup via src/utils/aadhaarConfig.js rather than silently.
# Both default to "true" (test mode) if unset.
NEXT_PUBLIC_ANON_AADHAAR_USE_TEST_MODE=true
ANON_AADHAAR_USE_TEST_MODE=true
# Seed distinguishing this app's nullifiers from other Anon Aadhaar apps using the
# same identity (any positive integer, must stay constant to keep nullifiers stable).
NEXT_PUBLIC_AADHAAR_NULLIFIER_SEED=12345

# --- Demo-only convenience values (safe to leave unset outside of demos) ---
NEXT_PUBLIC_DEMO_PRODUCT_HASH=
NEXT_PUBLIC_DEMO_SCAN_SECRET=
DEMO_SCAN_SECRET=
